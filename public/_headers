# Netlify response headers (copied into dist/ by Vite; works for Git deploys and drag-and-drop deploys alike).
# Audit №14: no page may be framed by another site (clickjacking), no MIME sniffing, no referrer leak, no device APIs.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/manifest.webmanifest
  Content-Type: application/manifest+json

/assets/*
  Cache-Control: public, max-age=31536000, immutable
