# Public values only. Never place service_role or Google client secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GAME_HUB_URL=
# Admin sign-in (admin.html). With Supabase: the login "Admin" maps to this email (create the user in
# Supabase Auth and give it role admin, see docs/server-api.md). Optional.
VITE_ADMIN_EMAIL=
# Local `npm run dev` only, when Supabase is not configured: demo admin login.
# Store the SHA-256 hex of the password, never the password itself. Ignored by production builds.
VITE_DEV_ADMIN_LOGIN=
VITE_DEV_ADMIN_PASSWORD_SHA256=
